{
  "name": "agent-cortex",
  "description": "Personal Copilot CLI plugin with custom agents and skills",
  "version": "1.5.0",
  "author": {
    "name": "jaybeeuu"
  },
  "license": "MIT",
  "repository": "https://github.com/jaybeeuu/agent-cortex",
  "agents": "agents/",
  "skills": "skills/",
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "beads": {
      "type": "stdio",
      "command": "/Users/joshbickley-wallace/.local/bin/beads-mcp",
      "args": [],
      "env": {
        "BEADS_PATH": "/opt/homebrew/bin/bd"
      },
      "tools": [
        "*"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "@modelcontextprotocol/server-github"
      ],
      "tools": [
        "*"
      ]
    }
  },
  "hooks": "hooks.json"
}
