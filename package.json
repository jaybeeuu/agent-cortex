{
  "name": "agent-cortex",
  "version": "1.19.0",
  "private": true,
  "description": "Personal PI package with custom agents, skills, and extensions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": "https://github.com/jaybeeuu/agent-cortex",
  "bin": {
    "agent-cortex": "./bin/agent-cortex.mjs"
  },
  "scripts": {
