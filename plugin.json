{
  "name": "agent-cortex",
  "description": "Personal Copilot CLI plugin with custom agents and skills",
  "version": "1.20.0",
  "author": {
    "name": "jaybeeuu"
  },
  "license": "MIT",
  "repository": "https://github.com/jaybeeuu/agent-cortex",
  "agents": "agents/",
  "skills": "skills/",
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "@modelcontextprotocol/server-github"
      ],
      "tools": [
        "*"
      ]
    }
  },
  "hooks": "hooks.json"
}
