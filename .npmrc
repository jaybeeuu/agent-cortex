# Bundled pi packages (pi-questions, pi-web-access) require a hoisted layout:
# pnpm refuses `bundledDependencies` under the default isolated linker
# (ERR_PNPM_BUNDLED_DEPENDENCIES_WITHOUT_HOISTED), and a hoisted node_modules is
# what makes `node_modules/<pkg>/...` resolvable both in the packed tarball and
# in the local checkout that pi loads as a package.
node-linker=hoisted
